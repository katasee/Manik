rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // The claim lives in the ID token; the app force-refreshes the token in
    // RootViewModel.refresh(), so it is current right after verification.
    function isVerifiedOwner(uid) {
      return isOwner(uid) && request.auth.token.email_verified == true;
    }

    function hasValidProfile() {
      return request.resource.data.name is string &&
        request.resource.data.email is string;
    }

    function hasValidBlockFormat() {
      return request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        request.resource.data.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        request.resource.data.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function hasValidServiceFormat() {
      return request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.price is int &&
        request.resource.data.price >= 0;
    }

    // Every master's data lives under her own document; only she can touch it, and only once
    // her email is verified. The one exception is creating the profile at sign-up, which
    // happens before the verification email is even sent.
    match /users/{uid} {
      allow create: if isOwner(uid) && hasValidProfile();
      allow update: if isVerifiedOwner(uid) && hasValidProfile();
      allow read, delete: if isVerifiedOwner(uid);

      match /services/{serviceId} {
        allow read, delete: if isVerifiedOwner(uid);
        allow create, update: if isVerifiedOwner(uid) && hasValidServiceFormat();
      }

      match /blocks/{blockId} {
        allow read, delete: if isVerifiedOwner(uid);
        allow create, update: if isVerifiedOwner(uid) && hasValidBlockFormat();
      }
    }
  }
}
