rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasValidBlockFormat() {
      return request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        request.resource.data.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        request.resource.data.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function hasValidServiceFormat() {
      return request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.price is int &&
        request.resource.data.price >= 0;
    }

    function isMaster() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "master";
    }

    function isClientBooking() {
      return isSignedIn() &&
        resource.data.status == "available" &&
        request.resource.data.status == "pending" &&
        request.resource.data.clientId == request.auth.uid &&
        request.resource.data.bookedServiceId in resource.data.offeredServiceIds &&
        request.resource.data.date == resource.data.date &&
        request.resource.data.startTime == resource.data.startTime &&
        request.resource.data.endTime == resource.data.endTime &&
        request.resource.data.offeredServiceIds == resource.data.offeredServiceIds;
    }

    function isClientCanceling() {
      return isSignedIn() &&
        resource.data.clientId == request.auth.uid &&
        request.resource.data.status == "available" &&
        !('clientId' in request.resource.data) &&
        !('bookedServiceId' in request.resource.data) &&
        request.resource.data.date == resource.data.date &&
        request.resource.data.startTime == resource.data.startTime &&
        request.resource.data.endTime == resource.data.endTime &&
        request.resource.data.offeredServiceIds == resource.data.offeredServiceIds;
    }

    match /users/{uid} {
      allow read: if isMaster() || request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.role == "client";
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
    }

    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow create, update: if isMaster() && hasValidServiceFormat();
      allow delete: if isMaster();
    }

    match /blocks/{blockId} {
      allow read: if isSignedIn();
      allow create: if isMaster() && hasValidBlockFormat();
      allow delete: if isMaster();
      allow update: if (isMaster() && hasValidBlockFormat()) || isClientBooking() || isClientCanceling();
    }
  }
}
