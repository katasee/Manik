rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function hasValidProfile() {
      return request.resource.data.name is string &&
        request.resource.data.email is string;
    }

    function hasValidBlockFormat() {
      return request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        request.resource.data.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        request.resource.data.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function hasValidServiceFormat() {
      return request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.price is int &&
        request.resource.data.price >= 0;
    }

    // Every master's data lives under her own document; only she can touch it.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && hasValidProfile();

      match /services/{serviceId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && hasValidServiceFormat();
      }

      match /blocks/{blockId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && hasValidBlockFormat();
      }
    }
  }
}
